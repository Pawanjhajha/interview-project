# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/auth_app
# Generate with: npm run generate-secret   (min 32 characters; the server refuses to start otherwise)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d
# bcrypt cost factor, 10 to 15
BCRYPT_ROUNDS=12
# Exact origin of the React app: used for CORS and the CSRF origin check
CLIENT_URL=http://localhost:5173
# Auth cookie: lax (default), strict, or none (none forces Secure; only for a cross-site client, see CLAUDE.md)
COOKIE_SAME_SITE=lax
